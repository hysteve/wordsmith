{
  "name": "wordsmith",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tools for smithing with words",
  "license": "ISC",
  "scripts": {
    "dev": "pnpm --filter @wordsmith/worker dev",
